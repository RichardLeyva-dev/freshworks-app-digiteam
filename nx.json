{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "npmScope": "digiteam",
  "defaultBase": "master",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default"],
    "sharedGlobals": []
  },
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "cacheableOperations": ["build", "lint", "test", "typecheck"]
      }
    }
  },
  "projects": {
    "zendesk": "packages/zendesk",
    "freshservice": "packages/freshservice",
    "ui": "packages/share"
  }
}


